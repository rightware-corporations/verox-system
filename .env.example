DB_URL=jdbc:postgresql://localhost:5432/verox
DB_USERNAME=verox
DB_PASSWORD=change-me
SERVER_PORT=8080

# Hosted checkout
VEROX_CHECKOUT_BASE_URL=http://localhost:3000
VEROX_CHECKOUT_TTL_MINUTES=15

# Webhook signing root secret. Use a long random production secret and never commit the real value.
VEROX_WEBHOOK_MASTER_SECRET=change-me-to-a-long-random-secret

# Persistent webhook delivery worker
VEROX_WEBHOOK_POLL_DELAY_MS=2000
VEROX_WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
VEROX_WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
VEROX_WEBHOOK_MAX_ATTEMPTS=8
VEROX_WEBHOOK_BASE_RETRY_SECONDS=10
VEROX_WEBHOOK_MAX_RETRY_SECONDS=900

# One-time MVP merchant provisioning. Keep disabled after the first successful bootstrap.
VEROX_BOOTSTRAP_ENABLED=false
VEROX_BOOTSTRAP_MERCHANT_NAME=VEROX MVP Merchant
VEROX_BOOTSTRAP_ENVIRONMENT=TEST

# One-time VEROX Bridge provisioning. Keep disabled after the first successful bootstrap.
VEROX_BRIDGE_BOOTSTRAP_ENABLED=false
VEROX_BRIDGE_BOOTSTRAP_MERCHANT_NAME=VEROX MVP Merchant
VEROX_BRIDGE_BOOTSTRAP_NAME=M-Pesa Receiving Bridge
VEROX_BRIDGE_BOOTSTRAP_PROVIDER=MPESA
